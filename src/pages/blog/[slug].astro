---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allArticles = await getCollection('articles');
  return allArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();

const formattedDate = new Date(article.data.publishedAt).toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric'
});

const whatsappUrl = "https://wa.me/5511914988818?text=Quero%20uma%20leitura%20do%20meu%20caso";
const pageTitle = article.data.title + " — Walter Inglez";
const articleUrl = "/blog/" + article.slug;
---

<Layout title={pageTitle} description={article.data.excerpt} canonical={articleUrl} type="article">
  <article class="max-w-3xl mx-auto px-6 py-12 md:py-16">
    <p class="text-xs uppercase tracking-widest text-[#c4956a] mb-4"><a href="/blog" class="hover:underline">Blog</a><span class="text-[#f5f0e8]/40 mx-2">·</span><span>{article.data.category}</span></p>
    <h1 class="font-serif text-3xl md:text-5xl font-bold text-[#f5f0e8] leading-tight mb-6">{article.data.title}</h1>
    <p class="text-sm text-[#f5f0e8]/40 mb-10">{formattedDate}</p>
    <p class="text-lg md:text-xl text-[#f5f0e8]/80 leading-relaxed mb-12 italic border-l-2 border-[#c4956a]/60 pl-5">{article.data.excerpt}</p>
    <div class="prose-content text-[#f5f0e8]/85 text-base md:text-lg leading-relaxed">
      <Content />
    </div>
    <aside class="mt-12 border-l-2 border-[#c4956a]/50 pl-6 py-2">
      <p class="text-sm italic leading-relaxed text-[#f5f0e8]/60">
        Este conteúdo tem finalidade exclusivamente informativa e não substitui a análise individual do caso concreto. Para avaliar sua situação específica, consulte um advogado habilitado.<br/>
        <span class="not-italic">Walter Inglez Advocacia e Consultoria — CNPJ 55.880.505/0001-80</span>
      </p>
    </aside>
  </article>

  <section class="border-t border-[#f5f0e8]/10 bg-[#0a1f1c]/50">
    <div class="max-w-3xl mx-auto px-6 py-12 md:py-16 text-center">
      <p class="mb-6 text-base italic text-[#f5f0e8]/70">Se o banco está pressionando e o papel está na mesa, este é o momento.</p>
      <p><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-md px-6 py-3 text-base font-medium bg-[#c4956a] text-[#0a1f1c] hover:bg-[#d4a57a] transition-colors">Solicitar triagem</a></p>
      <p class="mt-8 text-sm text-[#f5f0e8]/50"><a href="/blog" class="text-[#c4956a] hover:underline">← Ver outros artigos do blog</a></p>
    </div>
  </section>


</Layout>

<style is:global>
  .prose-content h2 { font-family: 'Playfair Display', Georgia, serif; font-size: 1.875rem; font-weight: 700; color: #f5f0e8; margin-top: 3rem; margin-bottom: 1rem; line-height: 1.2; }
  .prose-content h3 { font-family: 'Playfair Display', Georgia, serif; font-size: 1.5rem; font-weight: 600; color: #f5f0e8; margin-top: 2rem; margin-bottom: 0.75rem; }
  .prose-content p { margin-bottom: 1.25rem; }
  .prose-content a { color: #c4956a; text-decoration: underline; text-underline-offset: 4px; }
  .prose-content a:hover { color: #d4a57a; }
  .prose-content strong { color: #f5f0e8; font-weight: 600; }
  .prose-content em { font-style: italic; }
  .prose-content ul, .prose-content ol { margin: 1.25rem 0; padding-left: 1.5rem; }
  .prose-content li { margin-bottom: 0.5rem; }
  .prose-content blockquote { border-left: 2px solid #c4956a; padding-left: 1.25rem; font-style: italic; color: rgba(245, 240, 232, 0.7); margin: 1.5rem 0; }
  .prose-content table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.9rem; }
  .prose-content th, .prose-content td { border: 1px solid rgba(245, 240, 232, 0.2); padding: 0.75rem; text-align: left; }
  .prose-content th { background-color: rgba(196, 149, 106, 0.1); color: #f5f0e8; font-weight: 600; }
  .prose-content hr { border: none; border-top: 1px solid rgba(245, 240, 232, 0.15); margin: 2rem 0; }
</style>
