--- 
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const allArticles = await getCollection('articles');
const articles = allArticles.sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);
const currentPath = Astro.url.pathname;
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Como Funciona', href: '/como-funciona' },
  { label: 'Sobre', href: '/sobre' },
  { label: 'Blog', href: '/blog' },
  { label: 'Próximo Passo', href: '/proximo-passo' },
  { label: 'Contato', href: '/contato' },
];
---
<Layout
  title="Walter Inglez — Gestão Estratégica de Passivos Bancários"
  description="Antes de renegociar, entenda o que o contrato realmente produz. Leitura técnica para empresários sob pressão bancária."
  canonical="/"
>

  <header style="background:#0a1f1c; border-bottom:1px solid rgba(245,240,232,0.1); position:sticky; top:0; z-index:40;">
    <div style="max-width:1280px; margin:0 auto; padding:0 1.5rem; display:grid; grid-template-columns:auto 1fr auto; align-items:center; height:7rem; gap:2rem;">

      <a href="/" style="text-decoration:none; display:flex; align-items:center; gap:1.25rem;">
        <img src="/logo-wi.svg" alt="" aria-hidden="true"
          style="height:5rem; width:5rem; filter:brightness(0) invert(1) drop-shadow(0 1px 2px rgba(0,0,0,0.35));" />
        <span style="display:block; width:1px; height:3.5rem; background:rgba(245,240,232,0.2);"></span>
        <span style="display:flex; flex-direction:column; line-height:1.2;">
          <span style="font-family:'Playfair Display',Georgia,serif; font-size:1.6rem; font-weight:700; color:#f5f0e8; letter-spacing:0.14em;">WALTER INGLEZ</span>
          <span style="font-size:0.7rem; color:#c4956a; letter-spacing:0.32em; text-transform:uppercase; margin-top:0.375rem;">Advocacia e Consultoria</span>
        </span>
      </a>

      <p style="text-align:center; font-family:'Playfair Display',Georgia,serif; font-size:0.875rem; font-style:italic; color:rgba(245,240,232,0.5);">
        Gestão Estratégica de Passivos
      </p>

      <a href="https://wa.me/5511914988818?text=Quero%20uma%20leitura%20do%20meu%20caso"
        target="_blank" rel="noopener noreferrer"
        style="display:inline-flex; align-items:center; padding:0.5rem 1.25rem; background:#c4956a; color:#0a1f1c; font-size:0.875rem; font-weight:600; border-radius:0.375rem; text-decoration:none; white-space:nowrap;">
        Solicitar triagem
      </a>

    </div>

    <nav style="background:#112420; border-top:1px solid rgba(245,240,232,0.1);">
      <ul style="max-width:1280px; margin:0 auto; padding:0 1.5rem; display:flex; align-items:center; justify-content:center; gap:2rem; list-style:none; height:2.75rem;">
        {navItems.map(item => (
          <li>
            <a href={item.href}
              class={currentPath === item.href ? 'nav-active' : 'nav-item'}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </header>

  <section class="max-w-4xl mx-auto px-6 py-16 border-b border-[#f5f0e8]/10">
    <p class="text-xs uppercase tracking-widest text-[#c4956a] mb-4">Gestão estratégica de passivo bancário</p>
    <h2 class="font-serif text-4xl md:text-5xl font-bold text-[#f5f0e8] leading-tight mb-6">
      A dívida não é o único problema.<br />
      <span class="text-[#c4956a]">O risco está em decidir no escuro.</span>
    </h2>
    <p class="text-[#f5f0e8]/70 text-lg max-w-2xl leading-relaxed">
      Análise técnica para empresários com dívidas bancárias relevantes. Sem promessa de resultado. Com clareza sobre o que está em jogo.
    </p>
  </section>

  <main class="max-w-4xl mx-auto px-6 py-12">
    <h3 class="font-serif text-2xl font-semibold text-[#f5f0e8] mb-8">Artigos recentes</h3>
    <div class="space-y-6">
      {articles.map((article) => (
        
          href={"/blog/" + article.slug}
          class="block group border border-[#f5f0e8]/10 rounded-lg p-6 hover:border-[#c4956a]/40 transition-all"
        >
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1">
              <span class="text-xs uppercase tracking-widest text-[#c4956a] font-medium">
                {article.data.category}
              </span>
              <h4 class="font-serif text-xl font-semibold text-[#f5f0e8] mt-2 mb-2 group-hover:text-[#c4956a] transition-colors leading-snug">
                {article.data.title}
              </h4>
              <p class="text-[#f5f0e8]/60 text-sm leading-relaxed line-clamp-2">
                {article.data.excerpt}
              </p>
            </div>
            <span class="text-[#c4956a] text-xl mt-1 flex-shrink-0">→</span>
          </div>
          <div class="mt-4 text-xs text-[#f5f0e8]/30">
            {new Date(article.data.publishedAt).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}
          </div>
        </a>
      ))}
    </div>
  </main>

  <footer class="border-t border-[#f5f0e8]/10 mt-8">
    <div class="max-w-4xl mx-auto px-6 py-8 text-center text-sm text-[#f5f0e8]/30">
      {new Date().getFullYear()} Walter Inglez Advocacia e Consultoria | OAB/CE 51.563 | Fortaleza-CE e São Paulo-SP
    </div>
  </footer>

</Layout>

<style>
  .nav-item {
    font-size: 0.875rem;
    text-decoration: none;
    color: rgba(245,240,232,0.6);
    transition: color .2s;
  }
  .nav-item:hover {
    color: #f5f0e8;
  }
  .nav-active {
    font-size: 0.875rem;
    text-decoration: none;
    color: #f5f0e8;
    font-weight: 600;
  }
</style>
