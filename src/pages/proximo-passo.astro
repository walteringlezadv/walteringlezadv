---
import Layout from '../layouts/Layout.astro';

const paraQuemE = [
  "Empresa ou PJ ativa com operação em curso",
  "Passivo bancário relevante (a partir de R$ 200 mil)",
  "Proposta de renegociação ou aditivo pendente de assinatura",
  "Prazo curto para decidir antes da assinatura",
  "Pressão concreta do banco para formalização imediata",
];

const paraQuemNaoE = [
  "Pessoa física",
  "Empresa paralisada ou sem operação consolidada",
  "Recuperação judicial em fase inicial",
  "Quem busca redução automática de dívida",
];

const oQueEsperar = [
  "Retorno em até 48h úteis após o envio das informações",
  "Confirmação de aderência do caso ao escopo técnico",
  "Indicação objetiva do próximo passo coerente com o cenário",
  "Sem comunicação à instituição financeira nesta etapa",
];

const whatsappUrl = "https://wa.me/5511914988818?text=Quero%20uma%20leitura%20do%20meu%20caso";
const emailUrl = "mailto:contato@walteringlezadv.com.br?subject=Solicita%C3%A7%C3%A3o%20de%20triagem";
---

<Layout
  title="Próximo Passo — Walter Inglez"
  description="Critérios de aderência e próximos passos para empresas sob pressão bancária."
  canonical="/proximo-passo"
>
  <!-- Cabeçalho da página -->
  <section class="border-b border-[#f5f0e8]/10">
    <div class="max-w-3xl mx-auto px-6 py-16 md:py-20">
      <p class="text-xs uppercase tracking-widest text-[#c4956a] mb-4">Próximo Passo</p>
      <h1 class="font-serif text-4xl md:text-5xl font-bold text-[#f5f0e8] leading-tight mb-6">
        Próximo Passo
      </h1>
      <p class="text-[#f5f0e8]/70 text-lg leading-relaxed">
        Antes de avançar, confirme se o seu cenário corresponde ao escopo técnico desta triagem.
      </p>
    </div>
  </section>

  <!-- Para quem é · Para quem não é -->
  <section class="border-b border-[#f5f0e8]/10">
    <div class="max-w-5xl mx-auto px-6 py-12 md:py-16">
      <h2 class="text-center font-serif text-3xl md:text-4xl font-bold text-[#f5f0e8] leading-tight tracking-tight">
        Para quem é · Para quem não é
      </h2>

      <div class="mt-10 grid gap-6 md:grid-cols-2 md:gap-8">
        <!-- Para quem é -->
        <div class="rounded-lg border border-[#f5f0e8]/15 bg-[#f5f0e8]/[0.02] p-6 md:p-8">
          <h3 class="font-serif text-xl md:text-2xl text-[#f5f0e8]">
            Para quem é
          </h3>
          <ul class="mt-5 space-y-3 list-none p-0">
            {paraQuemE.map((item) => (
              <li class="flex items-start gap-3">
                <svg class="mt-1 h-4 w-4 shrink-0 text-[#c4956a]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-sm md:text-base leading-relaxed text-[#f5f0e8]/85">
                  {item}
                </span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Para quem não é -->
        <div class="rounded-lg border border-[#f5f0e8]/15 bg-[#f5f0e8]/[0.02] p-6 md:p-8">
          <h3 class="font-serif text-xl md:text-2xl text-[#f5f0e8]">
            Para quem não é
          </h3>
          <ul class="mt-5 space-y-3 list-none p-0">
            {paraQuemNaoE.map((item) => (
              <li class="flex items-start gap-3">
                <svg class="mt-1 h-4 w-4 shrink-0 text-[#f5f0e8]/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <span class="text-sm md:text-base leading-relaxed text-[#f5f0e8]/60">
                  {item}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- O que esperar após a solicitação -->
  <section class="border-b border-[#f5f0e8]/10 bg-[#0a1f1c]/50">
    <div class="max-w-3xl mx-auto px-6 py-10 md:py-14">
      <h2 class="font-serif text-3xl md:text-4xl font-bold text-[#f5f0e8] leading-tight tracking-tight">
        O que esperar após a solicitação
      </h2>
      <ul class="mt-8 grid gap-3 md:grid-cols-2 md:gap-4 list-none p-0">
        {oQueEsperar.map((item) => (
          <li class="flex items-start gap-3 rounded-md border border-[#f5f0e8]/15 bg-[#f5f0e8]/[0.02] p-4">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-[#c4956a]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-sm leading-relaxed text-[#f5f0e8]/85">
              {item}
            </span>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-xs leading-relaxed text-[#f5f0e8]/55">
        A triagem possui natureza jurídica e contratual, com foco na compreensão inicial do caso antes de qualquer aprofundamento formal.
      </p>
    </div>
  </section>

  <!-- Fechamento institucional - contato direto -->
  <section>
    <div class="max-w-3xl mx-auto px-6 py-12 md:py-16 text-center">
      <p class="mb-5 text-base italic text-[#f5f0e8]/70">
        Se o banco está pressionando e o papel está na mesa, este é o momento.
      </p>
      <p class="mx-auto mb-6 max-w-xl text-sm leading-relaxed text-[#f5f0e8]/85">
        A triagem começa pelo envio das informações essenciais da empresa e do passivo bancário envolvido.
      </p>
      <div class="flex flex-col items-center gap-4">
        <p class="text-xs text-[#f5f0e8]/60">
          Envie as informações iniciais para avaliação técnica.
        </p>
        
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-md px-6 py-3 text-base font-medium bg-[#c4956a] text-[#0a1f1c] hover:bg-[#d4a57a] transition-colors"
        >
          Solicitar triagem
        </a>
        
          href={emailUrl}
          aria-label="Enviar informações iniciais por e-mail"
          class="inline-flex items-center gap-2 text-sm font-medium text-[#f5f0e8] underline underline-offset-4 decoration-[#c4956a]/70 transition-colors hover:decoration-[#c4956a]"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Enviar por e-mail
        </a>
      </div>
      <p class="mx-auto mt-6 max-w-xl text-xs leading-relaxed text-[#f5f0e8]/55">
        Exclusivo para empresas com operação ativa. Retorno em até 48h úteis para confirmação de aderência e orientação do próximo passo.
      </p>
    </div>
  </section>

  <!-- Rodapé -->
  <footer class="border-t border-[#f5f0e8]/10 mt-8">
    <div class="max-w-4xl mx-auto px-6 py-8 text-center text-sm text-[#f5f0e8]/30">
      {new Date().getFullYear()} Walter Inglez Advocacia e Consultoria | OAB/CE 51.563 | Fortaleza-CE e São Paulo-SP
    </div>
  </footer>
</Layout>
