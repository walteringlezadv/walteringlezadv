---
const year = new Date().getFullYear();

const WHATSAPP_HREF = "https://wa.me/5511914988818?text=Quero%20uma%20leitura%20do%20meu%20caso";
const WHATSAPP_DISPLAY = "+55 11 91498-8818";
const EMAIL_HREF = "mailto:contato@walteringlezadv.com.br";
const EMAIL_ADDRESS = "contato@walteringlezadv.com.br";

const SOCIAL_LINKS = [
  {
    label: "Instagram",
    href: "https://instagram.com/walteringlezadv",
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>`,
  },
  {
    label: "YouTube",
    href: "https://youtube.com/@walteringlezadv",
    svg: `<svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
  },
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/walteringlezadv",
    svg: `<svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    label: "TikTok",
    href: "https://tiktok.com/@walteringlezadv",
    svg: `<svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43V8.71a8.16 8.16 0 0 0 4.77 1.52V6.78a4.85 4.85 0 0 1-1.84-.09Z"/></svg>`,
  },
];
---

<footer class="mt-16 border-t border-white/10 bg-[#1a2e22]">
  <div class="max-w-6xl mx-auto px-6 py-16 md:py-20">
    <div class="grid gap-14 md:grid-cols-2 md:gap-12 lg:grid-cols-4 lg:gap-16">

      <!-- Coluna 1 — Institucional -->
      <div class="space-y-3">
        <a href="/" class="block font-serif text-base leading-tight text-[#f5f0e8]/90">
          Walter Inglez Advocacia<br />e Consultoria
        </a>
        <p class="text-xs leading-relaxed text-[#f5f0e8]/80">
          Gestão estratégica do passivo bancário empresarial.
        </p>
        <p class="text-xs leading-relaxed text-[#f5f0e8]/80">
          Atendimento mediante triagem prévia.
        </p>
        <div class="pt-3 text-[11px] leading-relaxed text-[#f5f0e8]/60">
          <p>CNPJ: 55.880.505/0001-80</p>
        </div>
      </div>

      <!-- Coluna 2 — Contato -->
      <div class="space-y-5">
        <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-[#f5f0e8]/90">
          Contato
        </h3>
        <ul class="space-y-4">
          <li>
            <a
              href={WHATSAPP_HREF}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-start gap-3 text-sm text-[#f5f0e8]/60 hover:text-[#f5f0e8] transition-colors"
            >
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-[#c4956a]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
              <span>
                <span class="block text-[11px] uppercase tracking-wider text-[#f5f0e8]/60">WhatsApp</span>
                <span class="mt-0.5 block">{WHATSAPP_DISPLAY}</span>
              </span>
            </a>
          </li>
          <li>
            <a
              href="mailto:contato@walteringlezadv.com.br?subject=Contato%20pelo%20site" target="_blank" rel="noopener noreferrer"
              class="inline-flex items-start gap-3 text-sm text-[#f5f0e8]/60 hover:text-[#f5f0e8] transition-colors"
            >
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-[#c4956a]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>
                <span class="block text-[11px] uppercase tracking-wider text-[#f5f0e8]/60">E-mail</span>
                <span class="mt-0.5 block text-xs whitespace-nowrap">{EMAIL_ADDRESS}</span>
              </span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Coluna 3 — Endereços -->
      <div class="space-y-5">
        <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-[#f5f0e8]/90">
          Endereços
        </h3>
        <ul class="space-y-7">
          <li class="flex items-start gap-3">
            <svg class="mt-1 h-[18px] w-[18px] shrink-0 text-[#c4956a]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <div class="space-y-1.5">
              <p class="font-medium text-[15px] leading-tight text-[#f5f0e8]">Fortaleza – CE</p>
              <address class="not-italic text-sm leading-[1.65] text-[#f5f0e8]/60">
                R. Dr. Gilberto Studart, 55<br />
                Torre Sul, Sala 1.018<br />
                Cocó · CEP 60192-105
              </address>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg class="mt-1 h-[18px] w-[18px] shrink-0 text-[#c4956a]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <div class="space-y-1.5">
              <p class="font-medium text-[15px] leading-tight text-[#f5f0e8]">São Paulo – SP</p>
              <address class="not-italic text-sm leading-[1.65] text-[#f5f0e8]/60">
                Av. Paulista, 1636<br />
                Sala 1105/1064<br />
                Cerqueira César · CEP 01310-200
              </address>
            </div>
          </li>
        </ul>
      </div>

      <!-- Coluna 4 — Presença digital -->
      <div class="space-y-5">
        <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-[#f5f0e8]/90 lg:text-right">
          Presença digital
        </h3>
        <ul class="flex flex-wrap items-center justify-center gap-3 lg:justify-end">
          {SOCIAL_LINKS.map(({ label, href, svg }) => (
            <li>
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={label}
                title={label}
                class="inline-flex h-14 w-14 items-center justify-center rounded-full border border-white/20 text-[#f5f0e8]/60 transition-all duration-200 hover:border-[#c4956a] hover:text-[#c4956a]"
                set:html={svg}
              />
            </li>
          ))}
        </ul>
      </div>

    </div>

    <div class="mt-14 border-t border-white/10 pt-6 text-[11px] leading-relaxed text-[#f5f0e8]/40">
      © {year} Walter Inglez Advocacia e Consultoria. Todos os direitos reservados.
    </div>
  </div>
</footer>
